#!/bin/bash

CONF_DIR=/usr/share/nginx/html/build/dist/config/
SERVER_CONF="$CONF_DIR/server.json"
if [[ "${ARCUS_ENABLE_YEARLY_SUBSCRIPTION}" == "" ]]; then
    ARCUS_ENABLE_YEARLY_SUBSCRIPTION="0"
fi
if [[ "${ARCUS_ENABLE_HUB_WIFI_SCAN}" == "" ]]; then
    ARCUS_ENABLE_HUB_WIFI_SCAN="0"
fi
if [[ "${ARCUS_ENABLE_BATTERY_PERCENTAGE}" == "" ]]; then
    ARCUS_ENABLE_BATTERY_PERCENTAGE="0"
fi
if [[ "${ARCUS_ENABLE_PASSKEYS}" == "" ]]; then
    ARCUS_ENABLE_PASSKEYS="0"
fi

mkdir -p $CONF_DIR
# Overwrite (not append) so container restarts don't produce duplicate entries
cat > "$SERVER_CONF.tmp" <<EOF
{
   "apiUrl" : "$ARCUS_HTTP_URI",
   "redirectUrl" : "$ARCUS_REDIRECT_URI",
   "wsUrl"  : "$ARCUS_WS_URI",
   "iosDownloadUrl"  : "$ARCUS_IOS_DOWNLOAD_URI",
   "androidDownloadUrl"  : "$ARCUS_ANDROID_DOWNLOAD_URI",
   "enableYearlySubscription"  : $ARCUS_ENABLE_YEARLY_SUBSCRIPTION,
   "enableHubWifiScan"  : $ARCUS_ENABLE_HUB_WIFI_SCAN,
   "enableBatteryPercentage"  : $ARCUS_ENABLE_BATTERY_PERCENTAGE,
   "enablePasskeys"  : $ARCUS_ENABLE_PASSKEYS
}
EOF
mv "$SERVER_CONF.tmp" "$SERVER_CONF"

nginx -g 'daemon off;'
