<form ($submit)="addPasskey" autocomplete="off" {{#if saving}}disabled{{/if}}>
  <button type="submit" class="btn{{#if saving}} saving{{/if}}">
    {{#if saving}}
      <div class="loader"></div> Saving
    {{else}}
      Save
    {{/if}}
  </button>
  {{close-button type="cancel"}}

  {{#if formError}}
    <p class="form-error">{{formError}}</p>
  {{/if}}

  <div class="panel-content">
    <h2>Add a Passkey</h2>
    <p class="panel-description">A passkey lets you log in with your fingerprint, face, or screen lock instead of your password. When you select Save, your browser will ask where to keep the passkey.</p>
    {{textInput('name', 'Passkey Name', attributes='maxlength="64"')}}
    <p class="panel-context">The name is for telling your passkeys apart, so you might name it after the device or password manager that keeps it.</p>
  </div>
  <div hidden>
    <input type="submit"/>
  </div>
</form>
